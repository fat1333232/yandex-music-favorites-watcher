# Yandex Music OAuth Token
# Получить: pip install yandex-music && python -m yandex_music.oauth
YANDEX_TOKEN=

# Telegram Bot Token
# Получить: https://t.me/BotFather
TELEGRAM_TOKEN=

# Ваш Telegram Chat ID
# Получить: https://t.me/userinfobot
TELEGRAM_CHAT_ID=

# Путь к файлу кэша (в контейнере)
DATA_FILE=/app/data/favorites_cache.json

# Интервал проверки в секундах (по умолчанию 1 час)
CHECK_INTERVAL=3600 